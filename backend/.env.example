# ── BreezePost backend env (names only — fill values locally, NEVER commit) ──

# Supabase (values live in the repo-root .env). NEXT_PUBLIC_SUPABASE_URL +
# `supabase_secret_key` are honored as fallbacks by app/config.py.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudflare Workers AI. Posts use flux-2-klein (product photo + prompt).
# Captions use CLOUDFLARE_TEXT_MODEL on the same account. Flux cannot write text.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Image-edit model. 9b is currently rejected by Cloudflare's output filter
# (3030) on the same photos 4b accepts; keep 4b primary.
CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_EDIT_MODEL_FALLBACK=@cf/black-forest-labs/flux-2-klein-9b
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
CLOUDFLARE_TEXT_FALLBACKS=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Rendered post edge in px (square). 512 while developing; 1024 for demo day.
POST_IMAGE_SIZE=512

# Optional caption fallback — Groq free tier (keys start with gsk_).
# `grok_api_key` is still honored as a legacy alias for the same key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Telegram bot (pending @BotFather token at the time of scaffolding).
# The bot service fails gracefully with a clear log if this is absent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=true
TG_BOT_USERNAME=BreezePostBot

# Instagram publishing. mock = fake media id, nothing leaves the app.
# real = Instagram API; IG_USER_ID must be the id of the account the token
# was issued to (verify with GET /me — a mismatch 400s every publish).
PUBLISH_MODE=mock
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v24.0
