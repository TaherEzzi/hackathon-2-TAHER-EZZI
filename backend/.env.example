# ── BreezePost backend env (names only — fill values locally, NEVER commit) ──

# Supabase (values live in the repo-root .env). NEXT_PUBLIC_SUPABASE_URL +
# `supabase_secret_key` are honored as fallbacks by app/config.py.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Image generation — Cloudflare Workers AI (FLUX.1-schnell), primary provider
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# LLM provider — OpenRouter (captions + image fallback). Free tier gives
# ~50 text requests/day.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Optional caption fallback (xAI) used only if OPENROUTER_API_KEY is missing
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# Telegram bot (pending @BotFather token at the time of scaffolding).
# The bot service fails gracefully with a clear log if this is absent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=true
TG_BOT_USERNAME=BreezePostBot

# Instagram publishing. PUBLISH_MODE=mock keeps demos safe (fake media id).
PUBLISH_MODE=mock
IG_ACCESS_TOKEN=
IG_USER_ID=27568940546118261
IG_API_VERSION=v24.0
